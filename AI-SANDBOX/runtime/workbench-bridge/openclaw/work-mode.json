{
  "name": "lumi-work-mode",
  "status": "adapter-defined",
  "agent": "openclaw",
  "stateStore": "github",
  "executionBoundary": "workbench-bridge",
  "operations": [
    "work.status",
    "work.start",
    "work.run_task",
    "work.stop",
    "work.result"
